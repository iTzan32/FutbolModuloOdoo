<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario del asistente de creación rápida. -->
    <record id="view_create_match_wizard_form" model="ir.ui.view">
        <!-- Nombre técnico de la vista. -->
        <field name="name">football.create.match.wizard.form</field>
        <!-- Modelo temporal que usa el wizard. -->
        <field name="model">football.create.match.wizard</field>
        <!-- Campos que se piden al usuario en el popup. -->
        <field name="arch" type="xml">
            <form string="Crear partido rápido">
                <group>
                    <!-- Datos básicos para crear el partido. -->
                    <field name="team_id"/>
                    <field name="opponent"/>
                    <field name="match_date"/>
                    <field name="field_name"/>
                    <field name="match_type"/>
                    <field name="include_available_players"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <!-- Ejecuta el método Python que crea el partido. -->
                    <button name="action_create_match" string="Crear partido" type="object" class="btn-primary"/>
                    <!-- Cierra el popup sin guardar. -->
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción que abre el wizard en una ventana modal. -->
    <record id="action_create_match_wizard" model="ir.actions.act_window">
        <!-- Título del popup. -->
        <field name="name">Crear partido rápido</field>
        <!-- Modelo temporal abierto por la acción. -->
        <field name="res_model">football.create.match.wizard</field>
        <!-- Solo necesita vista formulario. -->
        <field name="view_mode">form</field>
        <!-- target new indica que se abre como popup. -->
        <field name="target">new</field>
    </record>

    <!-- Menú para abrir el asistente desde gestión deportiva. -->
    <menuitem id="menu_football_create_match_wizard"
              name="Crear partido rápido"
              parent="menu_football_management"
              action="action_create_match_wizard"
              sequence="40"/>
</odoo>
